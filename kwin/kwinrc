[Plugins]
rekta-turnstileEnabled=true
rekta-fadebackEnabled=true
rekta-metaholdEnabled=true
slideEnabled=false
# rekta-fadeback fades the splash out after login, in Rekta's duration and curve.
loginEnabled=false
# scale opens every layer surface of a namespace KWin does not know, the shell's too; Rekta gives it no meaning.
scaleEnabled=false
# screenedge lights an edge as a finger or the pointer comes near it; Rekta gives it no meaning.
screenedgeEnabled=false

# KWin has one blur for every surface and no radius: strength 5 comes closest to Rekta's 12px. Rekta adds no noise
# and no saturation.
[Effect-blur]
BlurStrength=5
NoiseStrength=0
Saturation=100

# rekta-fadeback holds the bottom touch edge for the Start, which opens over a full-screen window too. KWin keeps every
# edge active then, so the pointer corner KWin gives the overview by default would open it over a game or a video.
[ScreenEdges]
RemainActiveOnFullscreen=true

# KWin's ElectricNone: no corner. The overview stays on its shortcut.
[Effect-overview]
BorderActivate=9
