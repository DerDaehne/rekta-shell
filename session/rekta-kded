#!/bin/sh
# Runs Plasma's kded6 command. Only in the rekta session does kded6 read rekta's kded5rc, which keeps KDE's media
# controller unloaded: there the shell takes the media keys, for the player it shows.
if [ "${XDG_SESSION_DESKTOP:-}" = rekta ]; then
  export XDG_CONFIG_DIRS="@REKTA_KDED_CONFIG_DIR@:${XDG_CONFIG_DIRS:-/etc/xdg}"
fi
exec "$@"
