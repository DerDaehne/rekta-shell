#!/bin/sh
# Runs Plasma's KWin command. Only in the rekta session does KWin get rekta's effects and kwinrc defaults, the Rekta
# module they take their values from, the controls style whose Kirigami units follow KDE's animation speed, the
# shell package the lock screen greeter KWin starts takes its lock screen from, and the shell's D-Bus module that
# lock screen asks the shell with. Set here, the package name reaches the greeter alone; in the user manager the
# logout greeter would look for it too and find nothing.
if [ "${XDG_SESSION_DESKTOP:-}" = rekta ]; then
  export XDG_DATA_DIRS="@REKTA_KWIN_DATA_DIR@:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  export XDG_CONFIG_DIRS="@REKTA_KWIN_DATA_DIR@/kwin:${XDG_CONFIG_DIRS:-/etc/xdg}"
  export QT_PLUGIN_PATH="@REKTA_KWIN_PLUGIN_DIR@${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
  export QML_IMPORT_PATH="@REKTA_SHELL_DIR@:@REKTA_QML_DIR@${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
  export QT_QUICK_CONTROLS_STYLE=org.kde.desktop
  export PLASMA_DEFAULT_SHELL=rekta-lockscreen
fi
exec "$@"
